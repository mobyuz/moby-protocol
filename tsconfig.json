{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "rootDir": "generated",
    "outDir": "dist",
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": false
  },
  "include": ["generated/index.ts"]
}
