{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentTurnResponse",
  "description": "One event from an agent turn. A speech delta can precede a terminal\ncompletion. Tool calls, completions, and errors end the current request.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "const": "speech_delta"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "event",
        "text"
      ]
    },
    {
      "type": "object",
      "properties": {
        "call": {
          "$ref": "#/$defs/ToolCall"
        },
        "event": {
          "type": "string",
          "const": "tool_call"
        }
      },
      "additionalProperties": false,
      "required": [
        "event",
        "call"
      ]
    },
    {
      "type": "object",
      "properties": {
        "display_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "event": {
          "type": "string",
          "const": "completed"
        },
        "expression_hint": {
          "$ref": "#/$defs/Expression"
        },
        "speech_text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "event",
        "speech_text",
        "expression_hint"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/ApiError"
        },
        "event": {
          "type": "string",
          "const": "error"
        }
      },
      "additionalProperties": false,
      "required": [
        "event",
        "error"
      ]
    }
  ],
  "x-package-version": "0.1.0",
  "$defs": {
    "ApiError": {
      "description": "Public error details. Callers must redact provider errors and credentials.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "request_id"
      ]
    },
    "Expression": {
      "description": "Face states remain available locally when the backend is unreachable.",
      "type": "string",
      "enum": [
        "idle",
        "listening",
        "thinking",
        "speaking",
        "happy",
        "confused",
        "error",
        "muted",
        "disconnected"
      ]
    },
    "ReminderText": {
      "description": "User-visible reminder content, treated as plain text.",
      "type": "string",
      "maxLength": 200,
      "minLength": 1
    },
    "SearchLimit": {
      "description": "An inclusive bound on how many file names a search may return.",
      "type": "integer",
      "maximum": 50,
      "minimum": 1
    },
    "SearchQuery": {
      "description": "A literal substring matched against file names in a registered search root.",
      "type": "string",
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^(?!\\.{1,2}(?![\\s\\S]))[^/\\\\:\\x00-\\x1f\\x7f-\\x9f]+(?![\\s\\S])"
    },
    "StableId": {
      "description": "An opaque registry key: 1-64 ASCII characters, beginning with a lowercase\nletter and then containing only lowercase letters, digits, `_`, or `-`.\nTypeScript represents this as a string; validate untrusted JSON at runtime.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]{0,63}(?![\\s\\S])"
    },
    "ToolCall": {
      "type": "object",
      "properties": {
        "call_id": {
          "$ref": "#/$defs/StableId"
        },
        "request": {
          "$ref": "#/$defs/ToolRequest"
        }
      },
      "additionalProperties": false,
      "required": [
        "call_id",
        "request"
      ]
    },
    "ToolRequest": {
      "description": "An untrusted suggestion. The desktop resolves IDs and checks permissions\nand confirmation before any local action.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "project_id": {
              "$ref": "#/$defs/StableId"
            },
            "tool": {
              "type": "string",
              "const": "git_status"
            }
          },
          "additionalProperties": false,
          "required": [
            "tool",
            "project_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "app_id": {
              "$ref": "#/$defs/StableId"
            },
            "tool": {
              "type": "string",
              "const": "open_app"
            }
          },
          "additionalProperties": false,
          "required": [
            "tool",
            "app_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "app_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/StableId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "project_id": {
              "$ref": "#/$defs/StableId"
            },
            "tool": {
              "type": "string",
              "const": "open_project"
            }
          },
          "additionalProperties": false,
          "required": [
            "tool",
            "project_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "max_results": {
              "$ref": "#/$defs/SearchLimit"
            },
            "query": {
              "$ref": "#/$defs/SearchQuery"
            },
            "root_id": {
              "$ref": "#/$defs/StableId"
            },
            "tool": {
              "type": "string",
              "const": "search_files"
            }
          },
          "additionalProperties": false,
          "required": [
            "tool",
            "root_id",
            "query",
            "max_results"
          ]
        },
        {
          "type": "object",
          "properties": {
            "due_at": {
              "$ref": "#/$defs/ZonedDateTime"
            },
            "text": {
              "$ref": "#/$defs/ReminderText"
            },
            "tool": {
              "type": "string",
              "const": "create_reminder"
            }
          },
          "additionalProperties": false,
          "required": [
            "tool",
            "text",
            "due_at"
          ]
        }
      ]
    },
    "ZonedDateTime": {
      "description": "An RFC 3339 timestamp with an explicit offset and up to nine fractional\ndigits. Leap seconds are excluded from the scheduling contract.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]{1,9})?(?:[Zz]|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
    }
  }
}
