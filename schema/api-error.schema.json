{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApiError",
  "description": "Public error details. Callers must redact provider errors and credentials.",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "code",
    "message",
    "request_id"
  ],
  "x-protocol-version": "0.1.0"
}
