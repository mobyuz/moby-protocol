  "x-package-version": "0.2.0",
  "$defs": {
    "ActionDurationMs": {
      "description": "How long an expression or servo move lasts. Zero holds until the next command.",
      "type": "integer",
      "maximum": 60000,
      "minimum": 0
    },
    "AudioCodec": {
      "oneOf": [
        {
          "description": "Signed 16-bit little-endian PCM.",
          "type": "string",
          "const": "pcm_s16le"
        }
      ]
    },
    "AudioEnd": {
      "type": "object",
      "properties": {
        "duration_ms": {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 0
        },
        "frames": {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 0
        },
        "reason": {
          "$ref": "#/$defs/AudioEndReason"
        },
        "stream_id": {
          "$ref": "#/$defs/AudioStreamId"
        }
      },
      "additionalProperties": false,
      "required": [
        "stream_id",
        "reason",
        "frames",
        "duration_ms"
      ]
    },
    "AudioEndReason": {
      "type": "string",
      "enum": [
        "vad_silence",
        "max_duration",
        "button_release",
        "mute",
        "cancel",
        "error"
      ]
    },
    "AudioPlay": {
      "description": "Describes the desktop's audio for `audio_play_start` and `audio_play_end`.",
      "type": "object",
      "properties": {
        "codec": {
          "$ref": "#/$defs/AudioCodec"
        },
        "sample_rate": {
          "$ref": "#/$defs/SampleRate"
        },
        "stream_id": {
          "$ref": "#/$defs/AudioStreamId"
        }
      },
      "additionalProperties": false,
      "required": [
        "stream_id",
        "codec",
        "sample_rate"
      ]
    },
    "AudioStart": {
      "type": "object",
      "properties": {
        "channels": {
          "$ref": "#/$defs/ChannelCount"
        },
        "codec": {
          "$ref": "#/$defs/AudioCodec"
        },
        "frame_ms": {
          "$ref": "#/$defs/FrameMs"
        },
        "preroll_ms": {
          "$ref": "#/$defs/PrerollMs"
        },
        "reason": {
          "$ref": "#/$defs/AudioStartReason"
        },
        "sample_rate": {
          "$ref": "#/$defs/SampleRate"
        },
        "stream_id": {
          "$ref": "#/$defs/AudioStreamId"
        }
      },
      "additionalProperties": false,
      "required": [
        "stream_id",
        "reason",
        "codec",
        "sample_rate",
        "channels",
        "frame_ms",
        "preroll_ms"
      ]
    },
    "AudioStartReason": {
      "type": "string",
      "enum": [
        "wake",
        "button"
      ]
    },
    "AudioStreamId": {
      "description": "A nonzero audio stream, matching the frame header's stream ID.",
      "type": "integer",
      "maximum": 65535,
      "minimum": 1
    },
    "Button": {
      "type": "string",
      "enum": [
        "talk"
      ]
    },
    "ButtonAction": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "press",
            "release"
          ]
        },
        {
          "description": "Held for the robot's long-press time. A 10 s hold wipes pairing.",
          "type": "string",
          "const": "long_press"
        }
      ]
    },
    "ButtonEvent": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/ButtonAction"
        },
        "button": {
          "$ref": "#/$defs/Button"
        }
      },
      "additionalProperties": false,
      "required": [
        "button",
        "action"
      ]
    },
    "Cancel": {
      "type": "object",
      "properties": {
        "stream_id": {
          "$ref": "#/$defs/AudioStreamId"
        }
      },
      "additionalProperties": false,
      "required": [
        "stream_id"
      ]
    },
    "Capabilities": {
      "description": "Capability IDs a robot advertises: at most 8, so the longest hello fits one frame.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "maxItems": 8
    },
    "ChannelCount": {
      "description": "Interleaved PCM channels.",
      "type": "integer",
      "maximum": 2,
      "minimum": 1
    },
    "CommandKind": {
      "description": "The envelope `kind` of desktop requests. Each one gets a response.",
      "type": "string",
      "enum": [
        "command"
      ]
    },
    "ControlVersion": {
      "type": "integer",
      "const": 1,
      "minimum": 0
    },
    "DeviceConfig": {
      "description": "Optional device settings. The robot applies the fields present and keeps\nthe rest. `hello_ack` and `set_config` share this type.",
      "type": "object",
      "properties": {
        "max_utterance_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/MaxUtteranceMs"
            },
            {
              "type": "null"
            }
          ]
        },
        "speaker_volume": {
          "anyOf": [
            {
              "$ref": "#/$defs/Percent"
            },
            {
              "type": "null"
            }
          ]
        },
        "vad_silence_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/VadSilenceMs"
            },
            {
              "type": "null"
            }
          ]
        },
        "wake_sensitivity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Percent"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "DisplayText": {
      "type": "object",
      "properties": {
        "text": {
          "$ref": "#/$defs/ScreenText"
        },
        "ttl_ms": {
          "$ref": "#/$defs/TextTtlMs"
        }
      },
      "additionalProperties": false,
      "required": [
        "text",
        "ttl_ms"
      ]
    },
    "Empty": {
      "description": "The empty `data` object of messages that carry no fields.",
      "type": "object",
      "additionalProperties": false
    },
    "ErrorCode": {
      "description": "Robot error codes. The same codes appear in `error` events and in\n`command_error` responses.",
      "type": "string",
      "enum": [
        "E_PROTO_VERSION",
        "E_BAD_FRAME",
        "E_CRC",
        "E_STATE",
        "E_MUTED",
        "E_BUSY",
        "E_AUDIO_OVERRUN",
        "E_TIMEOUT",
        "E_UNSUPPORTED",
        "E_HW"
      ]
    },
    "ErrorDetail": {
      "description": "A diagnostic for people, never a secret.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+(?![\\s\\S])"
    },
    "ErrorInfo": {
      "description": "The payload of an `error` event and of a `command_error` response.",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "detail": {
          "$ref": "#/$defs/ErrorDetail"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "detail"
      ]
    },
    "EventKind": {
      "description": "The envelope `kind` of robot notifications.",
      "type": "string",
      "enum": [
        "event"
      ]
    },
    "Expression": {
      "description": "Face states remain available locally when the backend is unreachable.",
      "type": "string",
      "enum": [
        "idle",
        "listening",
        "thinking",
        "speaking",
        "happy",
        "confused",
        "error",
        "muted",
        "disconnected"
      ]
    },
    "FrameMs": {
      "description": "Audio per frame. One frame of PCM must fit in `MAX_PAYLOAD_LEN`.",
      "type": "integer",
      "maximum": 60,
      "minimum": 10
    },
    "Heartbeat": {
      "type": "object",
      "properties": {
        "mute": {
          "type": "boolean"
        },
        "state": {
          "$ref": "#/$defs/Expression"
        },
        "uptime_ms": {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "state",
        "mute",
        "uptime_ms"
      ]
    },
    "Hello": {
      "type": "object",
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/Capabilities"
        },
        "device_id": {
          "$ref": "#/$defs/StableId"
        },
        "fw_version": {
          "$ref": "#/$defs/VersionText"
        },
        "hw_rev": {
          "$ref": "#/$defs/VersionText"
        },
        "mute": {
          "type": "boolean"
        },
        "nonce": {
          "description": "Fresh for every hello, so a recorded proof cannot be replayed.",
          "$ref": "#/$defs/Nonce"
        },
        "paired": {
          "description": "Whether the robot holds a pairing key.",
          "type": "boolean"
        },
        "protocol_version": {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "device_id",
        "hw_rev",
        "fw_version",
        "protocol_version",
        "capabilities",
        "mute",
        "paired",
        "nonce"
      ]
    },
    "HelloAck": {
      "description": "`proof` and `desktop_nonce` are both present or both absent, and neither\nmay be `null`: the nonce\nexists only so the robot can prove itself back, which it does only after\nthe desktop's proof verified.",
      "type": "object",
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "config": {
          "$ref": "#/$defs/DeviceConfig"
        },
        "desktop_nonce": {
          "description": "Fresh for every `hello_ack`; present exactly when `proof` is. The\nrobot's `session_proof` covers it.",
          "$ref": "#/$defs/Nonce"
        },
        "proof": {
          "description": "Present only when the robot reported `paired` and the desktop holds\nthe key.",
          "$ref": "#/$defs/Proof"
        },
        "session_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "dependentRequired": {
        "desktop_nonce": [
          "proof"
        ],
        "proof": [
          "desktop_nonce"
        ]
      },
      "required": [
        "accepted",
        "config"
      ]
    },
    "MaxUtteranceMs": {
      "description": "The longest utterance before the robot stops listening.",
      "type": "integer",
      "maximum": 60000,
      "minimum": 1000
    },
    "MuteChanged": {
      "type": "object",
      "properties": {
        "muted": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/MuteSource"
        }
      },
      "additionalProperties": false,
      "required": [
        "muted",
        "source"
      ]
    },
    "MuteSource": {
      "oneOf": [
        {
          "description": "The user moved the hardware mute control.",
          "type": "string",
          "const": "switch"
        },
        {
          "description": "The robot reports the control's position at startup.",
          "type": "string",
          "const": "boot"
        }
      ]
    },
    "Nonce": {
      "description": "A fresh random value the robot sends in `hello`: 16 bytes.",
      "type": "string",
      "maxLength": 32,
      "minLength": 32,
      "pattern": "^[0-9a-f]{32}(?![\\s\\S])"
    },
    "PairBegin": {
      "type": "object",
      "properties": {
        "timeout_ms": {
          "$ref": "#/$defs/PairTimeoutMs"
        }
      },
      "additionalProperties": false,
      "required": [
        "timeout_ms"
      ]
    },
    "PairKey": {
      "description": "The shared pairing secret: 32 random bytes. `Debug` never prints it.\nSerialization still writes the key, because `pair_set_key` sends it.",
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "PairSetKey": {
      "type": "object",
      "properties": {
        "pair_key": {
          "$ref": "#/$defs/PairKey"
        }
      },
      "additionalProperties": false,
      "required": [
        "pair_key"
      ]
    },
    "PairTimeoutMs": {
      "description": "The window for the physical button press that confirms pairing.",
      "type": "integer",
      "maximum": 30000,
      "minimum": 1000
    },
    "Percent": {
      "description": "A setting expressed from 0 to 100.",
      "type": "integer",
      "maximum": 100,
      "minimum": 0
    },
    "PrerollMs": {
      "description": "Audio kept from before the wake word or button press.",
      "type": "integer",
      "maximum": 2000,
      "minimum": 0
    },
    "Proof": {
      "description": "HMAC-SHA256 over the session input: 32 bytes.",
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "ResponseKind": {
      "type": "string",
      "enum": [
        "response"
      ]
    },
    "SampleRate": {
      "description": "PCM samples per second per channel.",
      "type": "integer",
      "maximum": 48000,
      "minimum": 8000
    },
    "ScreenText": {
      "description": "A short line for the robot's screen. Control characters are rejected.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+(?![\\s\\S])"
    },
    "ServoPose": {
      "type": "object",
      "properties": {
        "duration_ms": {
          "$ref": "#/$defs/ActionDurationMs"
        },
        "pose": {
          "description": "A pose the firmware knows by name. Unknown names get `E_UNSUPPORTED`.",
          "$ref": "#/$defs/StableId"
        }
      },
      "additionalProperties": false,
      "required": [
        "pose",
        "duration_ms"
      ]
    },
    "SessionProof": {
      "description": "The robot's proof that it holds the pair key, sent once as the first event\nof an authenticated session.",
      "type": "object",
      "properties": {
        "proof": {
          "$ref": "#/$defs/Proof"
        }
      },
      "additionalProperties": false,
      "required": [
        "proof"
      ]
    },
    "SetExpression": {
      "type": "object",
      "properties": {
        "animation": {
          "description": "An animation the firmware knows by name. Unknown names get `E_UNSUPPORTED`.",
          "$ref": "#/$defs/StableId"
        },
        "duration_ms": {
          "$ref": "#/$defs/ActionDurationMs"
        },
        "state": {
          "$ref": "#/$defs/Expression"
        }
      },
      "additionalProperties": false,
      "required": [
        "state",
        "animation",
        "duration_ms"
      ]
    },
    "StableId": {
      "description": "An opaque registry key: 1-64 ASCII characters, beginning with a lowercase\nletter and then containing only lowercase letters, digits, `_`, or `-`.\nTypeScript represents this as a string; validate untrusted JSON at runtime.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]{0,63}(?![\\s\\S])"
    },
    "TextTtlMs": {
      "description": "How long display text stays on screen.",
      "type": "integer",
      "maximum": 60000,
      "minimum": 100
    },
    "VadSilenceMs": {
      "description": "Silence that ends an utterance.",
      "type": "integer",
      "maximum": 5000,
      "minimum": 200
    },
    "VersionText": {
      "description": "A hardware, firmware, or model version without whitespace.",
      "type": "string",
      "maxLength": 32,
      "minLength": 1,
      "pattern": "^[\\x21-\\x7e]+(?![\\s\\S])"
    },
    "WakeDetected": {
      "type": "object",
      "properties": {
        "model_id": {
          "$ref": "#/$defs/StableId"
        },
        "model_version": {
          "$ref": "#/$defs/VersionText"
        }
      },
      "additionalProperties": false,
      "required": [
        "model_id",
        "model_version"
      ]
    }
  }
}
